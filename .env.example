# Beispielwerte für den Logic Coach. Keine echten Schlüssel hier eintragen.
# Die echte DATABASE_URL bleibt in der lokalen .env oder in den Railway-Variablen.
#
# Einschalten: COACH_ENABLED=true und AI_API_KEY gesetzt.
# Abschalten: COACH_ENABLED=false (oder den Schlüssel entfernen).
# Ohne Schlüssel sieht niemand den Coach.

COACH_ENABLED=false
COACH_ENABLED_SUBJECTS=mathe
COACH_DAILY_LIMIT=60
COACH_MONTHLY_BUDGET_EUR=8
COACH_RETENTION_DAYS=90

# OVHcloud AI Endpoints (EU). Schlüssel nur hier oder in Railway, nie im Browser.
# Basis-URL geprüft, Modellliste kommt von GET /v1/models.
AI_BASE_URL=https://oai.endpoints.kepler.ai.cloud.ovh.net/v1
AI_API_KEY=
# Öffentliche Modell-IDs:
AI_MODEL_STRONG=gpt-oss-120b
AI_MODEL_FAST=Mistral-Small-3.2-24B-Instruct-2506
# Vorläufig alle Coach-Antworten mit dem schnellen Modell, auch Gesprächsstart und Fehlerdiagnose.
# gpt-oss-120b nur, wenn hier true steht. Standard: false.
COACH_USE_STRONG=false
# Diagnose-Code unter der Meldung im Coach-Fenster. Standard aus, echte Schüler sehen ihn nicht.
# Zum Testen im Schülerkonto in Railway unter Variables auf true setzen, danach wieder false.
COACH_DEBUG=false
