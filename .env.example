# Beispielwerte für den Logic Coach. Keine echten Schlüssel hier eintragen.
# Die echte DATABASE_URL bleibt in der lokalen .env oder in den Railway-Variablen.

# Coach ist aus, bis du ihn bewusst einschaltest.
COACH_ENABLED=false
# Testmodus: keine KI, feste Beispielantworten.
COACH_MOCK=true
# Leer = niemand. Später z. B. coach-test:25,dein-login:25
COACH_ALLOWED_USERS=
COACH_ENABLED_SUBJECTS=mathe
COACH_DAILY_LIMIT=25
COACH_MONTHLY_BUDGET_EUR=8
COACH_RETENTION_DAYS=90

# OVH, nur auf dem Server. Leer lassen, solange der Testmodus reicht.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL_STRONG=
AI_MODEL_FAST=
